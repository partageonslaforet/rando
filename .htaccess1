# Configuration de base
Options +FollowSymLinks
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Définir les types MIME
AddType application/javascript .js
AddType text/css .css

# Règles pour les fichiers statiques
RewriteRule ^assets/js/.*\.js$ - [L]
RewriteRule ^assets/css/.*\.css$ - [L]
RewriteRule ^assets/images/.*\.(jpg|jpeg|png|gif)$ - [L]

# Ne pas rediriger les fichiers et dossiers existants
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rediriger le reste vers index.php
RewriteRule ^(.*)$ index.php [L]
