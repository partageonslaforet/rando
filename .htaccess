# Fichier d'index par defaut
DirectoryIndex index.php

# Bloquer l'acces aux fichiers sensibles (dotfiles, logs, docs, config locale)
<FilesMatch "(^\.|\.(log|md|ini|lock|sql|sh|yml|yaml|dist|bak|example|env)$|^composer\.(json|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer l'acces aux dossiers internes (includes PHP uniquement, jamais servis en HTTP)
    RewriteRule ^(logs|config|src|vendor|database|migrations|scripts|actions|includes|templates/events/scripts)(/|$) - [F,L]

    # Interdire l'execution de scripts dans les uploads (fichiers statiques uniquement)
    RewriteRule ^(uploads|public/uploads)/.*\.(php|phtml|phar|php[0-9]|cgi|pl|py|sh)$ - [F,L,NC]

    # Alias interne /assets vers /public/assets et /uploads vers /public/uploads
    RewriteRule ^assets/(.*)$ /public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ /public/uploads/$1 [L]
    # Exposer les pages publiques subscribers
    RewriteRule ^subscribers/(.*)$ /public/subscribers/$1 [L]

    # Fichiers d'uploads manquants -> vrai 404 (evite de servir la home en 200,
    # ce qui faisait planter le parseur XML/GPX cote navigateur).
    # NB : on cible le chemin post-alias public/uploads/ — /uploads/... est reecrit
    # avant cette regle, REQUEST_FILENAME pointe alors sur le vrai fichier.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^public/uploads/ - [R=404,L]

    # Redirige toutes les requetes vers index.php sauf si le fichier ou dossier existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /index.php [QSA,L]
</IfModule>
